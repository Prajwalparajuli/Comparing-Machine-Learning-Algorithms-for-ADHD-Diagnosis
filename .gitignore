# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/

# Jupyter
.ipynb_checkpoints/

# Data and derived artifacts (do not commit raw data)
data/raw/
data/processed/
!data/SOURCE.txt
!data/README.md

# Results (generated outputs — regenerated by pipeline)
results/

# Reports (generated outputs)
reports/
!reports/.gitkeep

# Paper folder is allowed (contains no raw data)
paper/
!paper/.gitkeep
!paper/README.md
!paper/*.pdf
paper/figures/
!paper/figures/.gitkeep
!paper/figures/*

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/

# Pipeline orchestration scripts (local only)
run_*.ps1

# Analysis reports (local only)
ANALYSIS_REPORT.md