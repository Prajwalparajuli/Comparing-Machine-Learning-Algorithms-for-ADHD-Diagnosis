# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/

# Jupyter
.ipynb_checkpoints/

# Data (do not commit raw or processed data)
data/raw/
data/processed/
!data/SOURCE.txt
!data/README.md

# Results (generated by pipeline — regenerate with run scripts)
results/
!results/.gitkeep

# LaTeX auxiliary files
*.aux
*.log
*.out
*.synctex.gz
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.toc

# Paper folder — allow source and assets
!paper/
!paper/**
paper/figures/.gitkeep

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/